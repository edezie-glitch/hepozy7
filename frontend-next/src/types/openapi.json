    "/chat/quota": {
      "get": {
        "summary": "Get Quota",
        "description": "Same rolling-window logic as check_request_quota(), but returns the\nfull breakdown instead of just allowed/blocked — for showing a live\n\"23/50 messages, 12,400/20,000 tokens\" display in the frontend, or\nfor checking a user's status directly without waiting for them to\nactually hit the limit.",
