# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# LLM Providers
GROQ_API_KEY=gsk_your_groq_key
GEMINI_API_KEY=your_gemini_key

# Optional
OWNER_ADMIN_KEY=your-admin-secret
ENABLE_DOCS=1
ALLOWED_ORIGINS=*
LOCAL_DEV=1

# Request Quota Limits (Optional)
QUOTA_MAX_MESSAGES=200
QUOTA_MAX_TOKENS=100000

# Bot Guard & Rate Limiting (Optional)
BOT_HEAVY_PER_MIN=40
BOT_GENERAL_PER_MIN=240
BOT_LOCAL_HEAVY_PER_MIN=400
BOT_LOCAL_GENERAL_PER_MIN=2400
BOT_BYPASS_LOCAL=0
BOT_GUARD_DISABLED=0
